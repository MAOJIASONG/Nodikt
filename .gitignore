# ============================================================
# Nodikt .gitignore
# 注意：本文件之前存在未解决的 merge 冲突标记，已统一重写。
# ============================================================

# --- 依赖 / 编译产物 -----------------------------------------
node_modules/
**/node_modules/

server/dist/
server/dist-test/
web/dist/
dist/
build/
*.tsbuildinfo

# --- 密钥 / 环境变量 ------------------------------------------
.env
.env.*
!.env.example

# --- 运行时持久化文件（按需保留，敏感字段必须 ignore） ---------
# 唯一含 LLM API key 的文件 —— 绝对不能进 git
server/data/settings.json

# 其余 server/data/*.json 是运行时事件账本 / 会话状态，
# 含完整 demand 历史 / Claude session id / 用户对话内容。
# 默认 ignore；如果想保留 demo 数据可以 git add -f 强制添加。
server/data/demands.json
server/data/subgoals.json
server/data/executions.json
server/data/workers.json
server/data/decisions.json
server/data/events.json
server/data/memory.json
server/data/sessions.json
server/data/*.bak*
server/data/*.backup
server/data/*.tmp
server/data/settingsdeepseekv4flash.json
server/data/settingsclaude48.json

# Worker 运行时 HOME（含 CLI session 和 auth 状态）
.opencode-runtime/
.claude-code-runtime/

# Worker 实际工作目录（生成的代码 / artifact）
workspace/

# --- 日志 ----------------------------------------------------
# server/logs 里含完整 LLM 请求 / 响应 preview，敏感度较高
server/logs/
*.log
logs/

# --- 备份文件 ------------------------------------------------
*.bak
*.bak.*
package.json.bak

# --- 编辑器 / OS ---------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# --- Python 工具痕迹（远程模板带过来的，保留以防有 py 工具） ---
__pycache__/
*.py[codz]
*$py.class
*.so
.python-version
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.eggs/
*.egg-info/
*.egg
.venv/
venv/
env/

# --- AI 工具配置 ---------------------------------------------
.cursorignore
.cursorindexingignore
.claude/
CLAUDE.md

# --- 项目内部文档（本地保留，不推到远端） -----------------------
Nodikt_项目介绍.md
Nodikt_项目定义文档_稳态推进版.mdv2.md

# --- 杂项 ----------------------------------------------------
.abstra/
.pyre/
.pytype/
cython_debug/

# --- 启动脚本运行时数据 ---
.run/
