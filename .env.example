# Server port
PORT=3001

# OpenCode CLI install root (absolute path to the opencode folder containing bin/opencode)
OPENCODE_INSTALL_ROOT=/path/to/opencode

# OpenCode runtime HOME (where session state is stored). Defaults to ./.opencode-runtime under server/
OPENCODE_RUNTIME_HOME=

# Default workspace root used to spawn worker tasks. Defaults to ./workspace under server/
NODIKT_WORKSPACE_ROOT=

# Claude Code CLI install root (optional). Leave empty if `claude` is already on PATH.
# When set, the adapter uses `${CLAUDE_CODE_INSTALL_ROOT}/bin/claude` as the binary and
# prepends `${CLAUDE_CODE_INSTALL_ROOT}/bin` to PATH for spawned subprocesses.
CLAUDE_CODE_INSTALL_ROOT=

# Claude Code runtime HOME (where ~/.claude config & session state live).
# Defaults to ./.claude-code-runtime under server/. Set to /root (or your user home)
# to reuse an already-logged-in claude session instead of forcing a fresh login.
CLAUDE_CODE_RUNTIME_HOME=

# Claude Code permission mode for headless runs.
# Accepted values (per claude --help): default | acceptEdits | plan | bypassPermissions
# NOTE: bypassPermissions (= --dangerously-skip-permissions) is REFUSED by claude when the process
# runs as root/sudo. If you start the server as root, use acceptEdits — it auto-approves file edits
# while still gating Bash/Web tools through --allowedTools.
CLAUDE_CODE_PERMISSION_MODE=bypassPermissions

# Optional comma-separated allow/deny lists passed straight to `claude --allowedTools` / `--disallowedTools`.
# Example: CLAUDE_CODE_ALLOWED_TOOLS="Read,Edit,Write,Bash(npm test:*),Glob,Grep"
CLAUDE_CODE_ALLOWED_TOOLS=
CLAUDE_CODE_DISALLOWED_TOOLS=
