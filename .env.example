# Server port
PORT=3001

# OpenCode CLI install root (absolute path to the opencode folder containing bin/opencode)
OPENCODE_INSTALL_ROOT=/path/to/opencode

# OpenCode runtime HOME (where session state is stored). Defaults to ./.opencode-runtime under server/
OPENCODE_RUNTIME_HOME=

# Default workspace root used to spawn worker tasks. Defaults to ./workspace under server/
NODIKT_WORKSPACE_ROOT=
