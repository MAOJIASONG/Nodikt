{
  "name": "nodikt-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean:test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build:test": "npm run clean && npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --test-isolation=none \"dist-test/**/*.test.js\"",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "debug": "node --inspect=9229 dist/index.js",
    "debug:brk": "node --inspect-brk=9229 dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pino": "^8.21.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.80",
    "@types/ws": "^8.5.14",
    "pino-pretty": "^13.1.3",
    "typescript": "4.9.5"
  }
}
